# Banco
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=repobot

# Auth (gere com: openssl rand -base64 48)
JWT_SECRET=troque-isto-por-um-segredo-longo
JWT_ISSUER=repobot
JWT_AUDIENCE=repobot-web
JWT_ACCESS_TTL_MIN=15
REFRESH_TTL_DIAS=7

# Onde os repositórios são clonados
REPOS_DIR=./data/repos

# Worker da fila: inline (dentro do processo do Next) | off (rode `npm run worker` separado)
WORKER_MODE=inline

# LLM: local (sem modelo, respostas extrativas) | openai_compat (Ollama, OpenAI, Groq, xAI...)
LLM_PROVIDER=local
# Ollama expõe API compatível com OpenAI em /v1
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_CHAT_MODEL=qwen2.5:7b
# Deixe vazio para usar o embedding local (hashing de termos, sem rede)
LLM_EMBED_MODEL=
# Prefixos exigidos por alguns modelos (nomic-embed-text: "search_document: " / "search_query: ")
EMBED_PREFIX_DOC=
EMBED_PREFIX_QUERY=
