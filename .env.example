# cp .env.example .env   (o .env não vai para o git)
# O docker compose lê este arquivo sozinho; sem Docker, a api lê ao rodar `npm run dev`.

# LLM. Sem chave, o bot roda no modo extrativo (busca e cita, mas não explica).
LLM_API_KEY=
# precisa de tool calling para o modo agente
LLM_CHAT_MODEL=gpt-4.1-mini
# vazio = text-embedding-3-small quando há chave; "local" = embedding local, sem rede.
# Trocou o modelo? Sincronize os repositórios.
LLM_EMBED_MODEL=
# outro provedor compatível com a OpenAI (Groq, vLLM, Ollama...)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER=openai_compat
# alguns modelos de embedding pedem prefixo (ex.: nomic-embed-text)
# EMBED_PREFIX_DOC=search_document:
# EMBED_PREFIX_QUERY=search_query:

# Origem que pode fazer POST/PATCH/DELETE na api. Mude se abrir o web por outro endereço.
WEB_ORIGIN=http://localhost:3000

# Só sem Docker
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=tatubot
# JWKS_URL=http://localhost:3000/.well-known/jwks.json   (api)
# API_URL=http://localhost:4000                          (web)
# REPOS_DIR=./data/repos                                 (api)
# WORKER_MODE=inline                                     (api: worker no mesmo processo)
