# Copie para .env e preencha:   cp .env.example .env
#
# O .env está no .gitignore e NUNCA deve ser commitado. Este arquivo de
# exemplo é o único que vai para o repositório, então nada aqui é segredo.
#
# O docker compose lê o .env da raiz sozinho. Rodando sem Docker, a api lê
# este mesmo arquivo (npm run dev dentro de api/); o web não precisa de nada.

# ---------- LLM (OpenAI) ----------
# Com a chave preenchida, o bot explica as respostas e os embeddings passam
# a entender sinônimos. Sem chave, tudo funciona em modo local/extrativo.
# Crie a chave em https://platform.openai.com/api-keys
LLM_API_KEY=
# Modelo de chat (precisa de tool calling para o modo agente).
LLM_CHAT_MODEL=gpt-4.1-mini
# Modelo de embedding. Vazio = text-embedding-3-small quando há chave;
# "local" = embedding local, sem rede (para provedores sem /embeddings).
# Trocar o modelo exige sincronizar os repositórios (os vetores mudam).
LLM_EMBED_MODEL=
# Outro provedor compatível com a API da OpenAI (Groq, vLLM, Ollama...):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER=openai_compat   # vazio = automático (com chave -> openai_compat; sem -> local)

# Prefixos exigidos por alguns modelos de embedding (ex.: nomic-embed-text):
# EMBED_PREFIX_DOC=search_document:
# EMBED_PREFIX_QUERY=search_query:

# ---------- Rede ----------
# Origens que podem fazer POST/PATCH/DELETE na api (defesa contra CSRF).
# Mude se acessar o web por outro endereço (ex.: http://192.168.0.10:3000).
WEB_ORIGIN=http://localhost:3000

# ---------- Só para rodar sem Docker ----------
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=tatubot
# JWKS_URL=http://localhost:3000/.well-known/jwks.json   (api)
# API_URL=http://localhost:4000                          (web)
# JWT_PRIVATE_KEY_PATH=./data/chaves/jwt-privada.pem     (web; gerada sozinha)
# REPOS_DIR=./data/repos                                 (api)
# WORKER_MODE=inline                                     (api: worker no mesmo processo)
